uint8_t fb[8][128];  // 8 pages of 8 rows

void oledCmd(uint8_t c) {
  BUS.beginTransmission(OLED_ADDR);
  BUS.write(0x00);
  BUS.write(c);
  BUS.endTransmission();
}

bool oledBegin() {
  BUS.beginTransmission(OLED_ADDR);
  if (BUS.endTransmission() != 0) return false;
  const uint8_t init[] = {0xAE, 0xD5, 0x80, 0xA8, 0x3F, 0xD3, 0x00, 0x40, 0x8D, 0x14, 0xA1, 0xC8,
                          0xDA, 0x12, 0x81, 0xCF, 0xD9, 0xF1, 0xDB, 0x40, 0xA4, 0xA6, 0xAF};
  for (uint8_t c : init) oledCmd(c);
  return true;
}

void oledShow() {
  for (uint8_t page = 0; page < 8; page++) {
    oledCmd(0xB0 + page);
    oledCmd(0x00 + (OLED_COL_OFFSET & 0x0F));
    oledCmd(0x10 + (OLED_COL_OFFSET >> 4));
    for (uint8_t x = 0; x < 128; x += 16) {
      BUS.beginTransmission(OLED_ADDR);
      BUS.write(0x40);
      for (uint8_t i = 0; i < 16; i++) BUS.write(fb[page][x + i]);
      BUS.endTransmission();
    }
  }
}

void text(uint8_t line, const char *s) {  // 21 characters per line, 8 lines
  memset(fb[line], 0, 128);
  for (uint8_t i = 0; s[i] && i < 21; i++) {
    uint8_t c = (s[i] < 32 || s[i] > 127) ? '?' : s[i];
    memcpy(&fb[line][i * 6], FONT[c - 32], 5);
  }
}

// ------------------------------------------------------------------ numbers
// Formatted by hand: small cores often build snprintf without floating-point support.
char *fnum(char *out, float v, uint8_t dec, bool plus) {
  char *p = out;
  if (v < 0) { *p++ = '-'; v = -v; } else if (plus) { *p++ = '+'; }
  uint32_t scale = 1;
  for (uint8_t i = 0; i < dec; i++) scale *= 10;
  uint32_t n = (uint32_t)(v * scale + 0.5f);
  p += sprintf(p, "%lu", (unsigned long)(n / scale));
  if (dec) p += sprintf(p, ".%0*lu", dec, (unsigned long)(n % scale));
  return out;
}

// ------------------------------------------------------------------ main
bool mpuOk = false, oledOk = false;
float a[3], gy[3], tempC;
float mean[3] = {0, 0, 1}, sumSq = 0, peak = 0;
uint32_t samples = 0, windowN = 0, lastDraw = 0, lastPrint = 0, lastRead = 0, readErrors = 0;
float shownRms = 0, shownPeak = 0;

void setup() {
  Bridge.begin();
  Monitor.begin();
  BUS.begin();
  BUS.setClock(400000);
  mpuOk = mpuBegin();
  oledOk = oledBegin();
  Monitor.print("MPU6050 ");
  Monitor.print(mpuOk ? "ok" : "NOT FOUND");
  Monitor.print(", WHO_AM_I 0x");
  Monitor.print(whoAmI, HEX);
  Monitor.print("; OLED ");
  Monitor.println(oledOk ? "ok" : "NOT FOUND");
}

void loop() {
  uint32_t now = millis();
  if (mpuOk && now - lastRead >= 10) {  // about 100 readings a second for the display test
    lastRead = now;
    if (readAccel(a, gy, &tempC)) {
      samples++;
      float dyn2 = 0;
      for (int i = 0; i < 3; i++) {
        mean[i] += 0.02f * (a[i] - mean[i]);  // slow average = gravity
        float d = a[i] - mean[i];
        dyn2 += d * d;
      }
      sumSq += dyn2;
      windowN++;
      float mag = sqrtf(dyn2);
      if (mag > peak) peak = mag;
    } else {
      readErrors++;
    }
  }
  if (now - lastDraw >= 250) {
    lastDraw = now;
    if (windowN) {
      shownRms = sqrtf(sumSq / windowN);
      shownPeak = peak;
    }
    sumSq = 0;
    windowN = 0;
    peak = 0;
    char line[32], n1[16];
    text(0, "effente sensor test");
    snprintf(line, sizeof line, "ax %s g", fnum(n1, a[0], 3, true)); text(1, line);
    snprintf(line, sizeof line, "ay %s g", fnum(n1, a[1], 3, true)); text(2, line);
    snprintf(line, sizeof line, "az %s g", fnum(n1, a[2], 3, true)); text(3, line);
    snprintf(line, sizeof line, "vib  %s mg rms", fnum(n1, 1000 * shownRms, 1, false)); text(4, line);
    snprintf(line, sizeof line, "peak %s mg", fnum(n1, 1000 * shownPeak, 1, false)); text(5, line);
    snprintf(line, sizeof line, "gyro %s deg/s", fnum(n1, gy[2], 1, true)); text(6, line);
    snprintf(line, sizeof line, "%sC n=%lu", fnum(n1, tempC, 1, false), (unsigned long)samples); text(7, line);
    if (!mpuOk) text(1, "MPU6050 not found");
    if (oledOk) oledShow();
  }
  if (now - lastPrint >= 1000) {
    lastPrint = now;
    char line[128], x[16], y[16], z[16], r[16], pk[16], tc[16];
    snprintf(line, sizeof line, "a %s %s %s g | vib %s mg rms | peak %s mg | %s C | n %lu | errors %lu",
             fnum(x, a[0], 3, true), fnum(y, a[1], 3, true), fnum(z, a[2], 3, true), fnum(r, 1000 * shownRms, 1, false),
             fnum(pk, 1000 * shownPeak, 1, false), fnum(tc, tempC, 1, false), (unsigned long)samples,
             (unsigned long)readErrors);
    Monitor.println(line);
  }
}
