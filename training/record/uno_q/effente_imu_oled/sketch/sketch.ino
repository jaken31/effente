// effente sensor test: MPU6050 readings on the OLED screen.
//
// Both devices are on Wire2 (found by the imu_i2c_scan app): the MPU6050 at 0x68 and the
// OLED at 0x3C. The screen driver is built in (SSD1306/SSD1309 or SH1106 controller, page
// addressing), so no display library has to be downloaded. The same numbers go to the serial
// monitor once a second. A test of the wiring and settings, not the device's data stream.
//
// MPU6050 settings, as recommended in device/intake/source.py: accelerometer +-8 g
// (4096 counts per g), gyroscope +-250 deg/s, digital low-pass 260 Hz, 1 kHz sample rate.

#include <Arduino_RouterBridge.h>
#include <Wire.h>

TwoWire &BUS = Wire2;
const uint8_t MPU_ADDR = 0x68, OLED_ADDR = 0x3C;  // not "MPU": that name is the chip's memory protection unit
const uint8_t OLED_COL_OFFSET = 0;  // 2 for an SH1106 controller (text shifted or cut off at the edge)
const float COUNTS_PER_G = 4096.0f;

// ------------------------------------------------------------------ MPU6050
bool mpuWrite(uint8_t reg, uint8_t val) {
  BUS.beginTransmission(MPU_ADDR);
  BUS.write(reg);
  BUS.write(val);
  return BUS.endTransmission() == 0;
}

int mpuRead(uint8_t reg, uint8_t *buf, uint8_t n) {
  BUS.beginTransmission(MPU_ADDR);
  BUS.write(reg);
  if (BUS.endTransmission(false) != 0) return -1;
  uint8_t got = BUS.requestFrom(MPU_ADDR, n);
  for (uint8_t i = 0; i < got; i++) buf[i] = BUS.read();
  return got;
}

uint8_t whoAmI = 0;

bool mpuBegin() {
  mpuRead(0x75, &whoAmI, 1);           // WHO_AM_I: 0x68 on a real MPU6050
  return mpuWrite(0x6B, 0x01)          // PWR_MGMT_1: wake up, clock from the X gyro
         && mpuWrite(0x1A, 0x00)       // CONFIG: low-pass 260 Hz (accelerometer)
         && mpuWrite(0x19, 7)          // SMPLRT_DIV: 8 kHz / (1 + 7) = 1 kHz
         && mpuWrite(0x1B, 0x00)       // GYRO_CONFIG: +-250 deg/s
         && mpuWrite(0x1C, 0x10);      // ACCEL_CONFIG: +-8 g
}

bool readAccel(float a[3], float g[3], float *tempC) {
  uint8_t b[14];
  if (mpuRead(0x3B, b, 14) != 14) return false;
  for (int i = 0; i < 3; i++) {
    a[i] = (int16_t)((b[2 * i] << 8) | b[2 * i + 1]) / COUNTS_PER_G;
    g[i] = (int16_t)((b[8 + 2 * i] << 8) | b[9 + 2 * i]) / 131.0f;
  }
  *tempC = (int16_t)((b[6] << 8) | b[7]) / 340.0f + 36.53f;
  return true;
}

